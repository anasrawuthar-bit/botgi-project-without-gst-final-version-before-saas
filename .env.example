# ==========================================
# Production Django Environment Variables
# ==========================================
# Generate a new 50+ character key using:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key-50-chars-min

# Set to False in production
DJANGO_DEBUG=False

# Comma-separated allowed domain names / IP addresses
DJANGO_ALLOWED_HOSTS=dir.anasrawuthar.in,127.0.0.1,localhost

# Trusted CSRF origins for web dashboards (must start with https://)
DJANGO_CSRF_TRUSTED_ORIGINS=https://dir.anasrawuthar.in

# Enforce HTTPS redirect and secure cookies in production
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True

# HTTP Strict Transport Security (HSTS) - set to 31536000 (1 year) when all traffic is HTTPS
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# Base URL used for public links and QR code generation
PUBLIC_BASE_URL=https://dir.anasrawuthar.in
WEB_RELEASE_VERSION=2026.04.20.1
WEB_RELEASE_POLL_INTERVAL_SECONDS=300

# WhatsApp Bridge (optional local QR login service)
WHATSAPP_BRIDGE_AUTO_START=True
WA_BRIDGE_PORT=3001
WA_CLIENT_ID=botgi_default
WA_HEADLESS=false

# Use one of the following database options.
# DATABASE_URL=postgres://botgi_user:botgi_password@db-host:5432/botgi_db
# SQLITE_PATH=C:\path\to\db.sqlite3
